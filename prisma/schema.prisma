generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Media {
  id           Int       @id @default(autoincrement())
  vehicle      Int?
  wheel        Int?
  url          String
  is_thumbnail Boolean   @default(false)
  date_created DateTime? @default(now())
  vehicles     Vehicle?  @relation(fields: [vehicle], references: [id], onDelete: Cascade)
  wheels       Wheel?    @relation(fields: [wheel], references: [id], onDelete: Cascade)
}

model Review {
  id           Int       @id @default(autoincrement())
  vehicle      Int?
  wheel        Int?
  title        String?
  description  String?
  rating       Decimal?
  date_created DateTime? @default(now())
  vehicles     Vehicle?  @relation(fields: [vehicle], references: [id], onDelete: Cascade)
  wheels       Wheel?    @relation(fields: [wheel], references: [id], onDelete: Cascade)
}

model Vehicle {
  id                                Int                  @id @default(autoincrement())
  slug                              String               @unique
  thumbnail_url                     String?
  model                             String
  mileage                           Int?
  price_cts                         Int?
  date_created                      DateTime?            @default(now())
  year                              Int?
  description                       String?
  brand                             VehicleBrand?
  country                           VehicleCountry?
  body_style                        VehicleBodyStyle?
  weight_lbs                        Int?
  power_bhp                         Int?
  zero_to_sixty_seconds             Decimal?
  top_speed_mph                     Int?
  fuel_type                         VehicleFuelType?
  drivetrain                        VehicleDrivetrain?
  transmission                      VehicleTransmission?
  condition                         VehicleCondition?
  engine_cylinder_count             Int?
  engine_displacement_volume_liters Decimal?
  engine_layout                     VehicleEngineLayout?
  medias                            Media[]
  reviews                           Review[]
  vehicles_wheels                   Vehicles_Wheels[]
}

model Vehicles_Wheels {
  id         Int @id @default(autoincrement())
  wheel_id   Int
  vehicle_id Int

  vehicles Vehicle @relation(fields: [vehicle_id], references: [id], onDelete: Cascade)
  wheels   Wheel   @relation(fields: [wheel_id], references: [id], onDelete: Cascade)

  @@unique([vehicle_id, wheel_id])
}

model Wheel {
  id                  Int               @id @default(autoincrement())
  slug                String            @unique
  thumbnail_url       String?
  brand               WheelBrand?
  model               String?
  price_cts           Int?
  date_created        DateTime?         @default(now())
  delivery_available  Boolean           @default(false)
  free_on_site_pickup Boolean           @default(false)
  sizes               Json
  tires               Json
  consumption         WheelConsumption?
  is_four_lug         Boolean           @default(false)
  is_five_lug         Boolean           @default(false)
  is_six_lug          Boolean           @default(false)
  is_eight_lug        Boolean           @default(false)
  is_central_lug      Boolean           @default(false)
  is_three_lug        Boolean           @default(false)
  is_ten_lug          Boolean           @default(false)
  medias              Media[]
  reviews             Review[]
  vehicles_wheels     Vehicles_Wheels[]
}

enum VehicleBrand {
  AUTOBELLO
  BRUCKELL
  BURNSIDE
  CHERRIER
  CIVETTA
  ETK
  FPU
  GAVRIL
  HIROSHI
  IBISHU
  SP
  SOLIAD
  WENTWARD
}

enum VehicleCountry {
  USA
  ITALY
  FRANCE
  GERMANY
  POLAND
  JAPAN
}

enum VehicleEngineLayout {
  L
  F
  V
  W
}

enum VehicleFuelType {
  GASOLINE
  DIESEL
  BATTERY
}

enum VehicleDrivetrain {
  RWD
  FWD
  AWD
  FOURWD         @map("4WD")
  EIGHT_BY_EIGHT @map("8x8")
  EIGHT_BY_FOUR  @map("8x4")
  EIGHT_BY_SIX   @map("8x6")
  FIVE_BY_TWO    @map("5x2")
  FOUR_BY_FOUR   @map("4x4")
  SIX_BY_FOUR    @map("6x4")
  SIX_BY_SIX     @map("6x6")
  SIX_BY_TWO     @map("6x2")
  THREE_BY_THREE @map("3x3")
}

enum VehicleTransmission {
  MANUAL
  AUTOMATIC
  SEQUENTIAL
  DCT
  CVT
  OTHER
}

enum VehicleBodyStyle {
  PICKUP
  AMBULANCE
  ATV
  BOX_TRUCK
  BUGGY
  BUS
  CHASSIC_CAB
  COUPE
  DUMP_TRUCK
  FIFTH_WHEEL_TRUCK
  FLATBED
  FLATBED_TRUCK
  HATCHBACK
  JATO_TRUCK
  LIFTBACK
  LOGGING_TRUCK
  MINIVAN
  MIXER_TRUCK
  ROADSTER
  SEDAN
  SHOOTING_BRAKE
  SUV
  TANKER_TRUCK
  VAN
  WAGON
}

enum WheelBrand {
  ALDER
  AUTOBELLO
  BETA
  BRUCKELL
  CHERRIER
  CIVETTA
  CLOCKWISE
  DREID
  ETK
  FOLK
  GAVRIL
  GP
  GRIP_ALL
  HIROSHI
  IBISHU
  LEGNO
  NO_BRAND
  OKUDAI
  SOLIAD
  SP
  STX
  TIMS
  TRIAL
  WANGAN
  UTR
}

enum WheelConsumption {
  A
  B
  C
  D
  E
  F
  G
}

enum VehicleCondition {
  USED
  JUNKYARD
}
